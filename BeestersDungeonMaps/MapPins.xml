<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/ https://raw.githubusercontent.com/Gethe/wow-ui-source/live/Interface/AddOns/Blizzard_SharedXML/UI.xsd">
    <!--
        Map pin template. No <Scripts> here on purpose: the world map calls the mixin's
        OnLoad, OnMouseEnter and OnMouseLeave itself, and it refuses pins whose template sets
        OnEnter/OnLeave scripts (assertion in MapCanvasMixin:AcquirePin).
        enableMouseMotion lets the map hook up hovering; enableMouseClicks makes the map call
        the mixin's OnClick (left click opens the dungeon map, right click zooms out as usual).
    -->
    <Frame name="BeestersDungeonMapsEntrancePinTemplate" mixin="BeestersDungeonMapsEntrancePinMixin" enableMouseMotion="true" enableMouseClicks="true" virtual="true">
        <Size x="24" y="24"/>
        <Layers>
            <Layer level="ARTWORK">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>
    <!-- Where a quest starts ("Show on map" in the dungeon quest panel). Same rules as above. -->
    <Frame name="BeestersDungeonMapsMarkerPinTemplate" mixin="BeestersDungeonMapsMarkerPinMixin" enableMouseMotion="true" virtual="true">
        <Size x="30" y="30"/>
        <Layers>
            <Layer level="OVERLAY">
                <Texture parentKey="Icon" setAllPoints="true"/>
            </Layer>
        </Layers>
    </Frame>
</Ui>
